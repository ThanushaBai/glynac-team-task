#!/usr/bin/env bash
set -euo pipefail

if [[ "$1" != PREFIX=* ]]; then
  echo "Error: Usage is ./scripts/team-up PREFIX=lab-team COUNT=3"
  exit 1
fi
PREFIX="${1#PREFIX=}"
COUNT="${2#COUNT=}"
export TF_VAR_team_prefix="$PREFIX"
export TF_VAR_team_count="$COUNT"

echo "🚀 Starting creation of $COUNT environment(s) with prefix '$PREFIX'..."

cd terraform
terraform init -upgrade
terraform apply -var="team_prefix=$PREFIX" -var="team_count=$COUNT" -auto-approve
cd ..

echo "✅ Environments created successfully!"

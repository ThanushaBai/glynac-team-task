#!/usr/bin/env bash
set -euo pipefail

PREFIX=""
COUNT=1

for arg in "$@"; do
  case "$arg" in
    PREFIX=*) PREFIX="${arg#PREFIX=}" ;;
    COUNT=*)  COUNT="${arg#COUNT=}" ;;
  esac
done

if [[ -z "$PREFIX" ]]; then
  echo "Error: Usage is ./scripts/team-down PREFIX=lab-team COUNT=3"
  exit 1
fi

export TF_VAR_team_prefix="$PREFIX"
export TF_VAR_team_count="$COUNT"

echo "🔥 Destroying $COUNT environment(s) with prefix '$PREFIX'..."

cd terraform
terraform destroy -var="team_prefix=$PREFIX" -var="team_count=$COUNT" -auto-approve
cd ..

echo "✅ Environments destroyed."
